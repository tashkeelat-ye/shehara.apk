{
  "name": "shehara-android-app",
  "private": true,
  "version": "1.0.0",
  "description": "تطبيق شهارة لأندرويد (Capacitor - Remote URL) يعرض https://shehara-ye.vercel.app",
  "scripts": {
    "build": "echo 'وضع Remote URL: لا يوجد أصول ويب لبنائها، الموقع يُحمَّل مباشرة عبر server.url في capacitor.config.ts'",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "assets:generate": "capacitor-assets generate --android",
    "build:apk:debug": "cd android && ./gradlew assembleDebug",
    "build:apk:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0"
  }
}
