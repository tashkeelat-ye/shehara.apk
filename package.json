{
  "name": "shehara-android-app",
  "private": true,
  "version": "1.0.0",
  "description": "تطبيق شهارة لأندرويد (نسخة مستقلة تعتمد على Capacitor) — يعرض https://shehara-ye.vercel.app داخل غلاف Android أصلي.",
  "scripts": {
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "assets:generate": "capacitor-assets generate --android",
    "build:apk:debug": "cd android && ./gradlew assembleDebug",
    "build:apk:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/app": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/splash-screen": "^7.4.0",
    "@capacitor/status-bar": "^7.4.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.0"
  }
}
